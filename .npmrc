# PNPM Configuration

# Use the strict peer dependency mode
# This will fail installation if peer dependencies are not satisfied
strict-peer-dependencies=true

# Save exact versions by default (important for monorepos)
save-exact=false

# Use shamefully-hoist to flatten node_modules (optional, but helpful for compatibility)
# shamefully-hoist=true

# Node linker: hard-links (faster, less disk space)
node-linker=hard-links

# Prefer the workspace protocol for internal dependencies
prefer-workspace-packages=true

# Auto-install peer dependencies
auto-install-peers=true

# Symlink binaries instead of copying
symlink=true

# Registry configuration
registry=https://registry.npmjs.org/

# If you have a private registry, add:
# @mip:registry=https://your-private-registry.com/

# Lockfile format (v5.4 is stable)
lockfile-version=5.4

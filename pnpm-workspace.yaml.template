# pnpm workspaces configuration
# This file tells pnpm which directories contain package.json files to manage as a monorepo

packages:
  - 'packages/*'
  - 'docs'  # Optional: if docs should be a package with its own scripts

# Pre vs post install scripts (optional)
# preinstall: ""
# postinstall: ""

# Shared dependency hoisting rules
# hoist-pattern:
#   - '*'                 # Hoist all dependencies
# hoist-pattern-blacklist:
#   - 'react'             # Don't hoist react (keep in each package)
#   - 'react-dom'

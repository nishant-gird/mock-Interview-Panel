{
  "name": "mip-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Mock Interview Panel - Full-Stack Monorepo",
  "license": "UNLICENSED",
  "author": "",
  "keywords": ["interview", "mock-interview", "ai"],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/mip.git"
  },
  "workspaces": {
    "packages": [
      "packages/backend",
      "packages/frontend"
    ]
  },
  "engines": {
    "pnpm": ">=8.0.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "install-all": "pnpm install",
    "build": "pnpm --recursive run build",
    "build:backend": "pnpm --filter @mip/backend run build",
    "build:frontend": "pnpm --filter @mip/frontend run build",
    "dev": "pnpm --recursive run dev --parallel",
    "dev:backend": "pnpm --filter @mip/backend run start:dev",
    "dev:frontend": "pnpm --filter @mip/frontend run dev",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint -- --fix",
    "format": "pnpm --recursive run format",
    "format:check": "pnpm --recursive run format -- --check",
    "test": "pnpm --recursive run test",
    "test:watch": "pnpm --recursive run test:watch",
    "test:cov": "pnpm --recursive run test:cov",
    "type-check": "pnpm --recursive run type-check",
    "clean": "pnpm --recursive run clean && rm -rf node_modules .pnpm-store",
    "clean:deps": "pnpm --recursive exec rm -rf node_modules dist coverage",
    "deps:check": "pnpm outdated --recursive",
    "deps:update": "pnpm update --recursive --latest"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "prettier-plugin-tailwindcss": "^0.6.5"
  }
}
